VITE_SHARED_FEED_URL=/shared-feed
# TonConnect (Telegram Mini App wallet flow):
# Keep manifest at the root URL of your public app host.
# VITE_TONCONNECT_MANIFEST_URL=https://your-public-host/tonconnect-manifest.json
# TMA return URL to reopen your Mini App after wallet actions:
# VITE_TWA_RETURN_URL=https://t.me/tondiscover
# Optional creator reputation contract on TON:
# VITE_CREATOR_REPUTATION_CONTRACT_ADDRESS=

# Optional split read/write endpoints:
# VITE_SHARED_FEED_READ_URL=
# VITE_SHARED_FEED_WRITE_URL=
# VITE_SHARED_FEED_WRITE_METHOD=PUT
# VITE_SHARED_FEED_TOKEN=

# Optional shared-feed server settings (for npm run shared-feed):
# SHARED_FEED_HOST=0.0.0.0
# SHARED_FEED_PORT=8787
# SHARED_FEED_TOKEN=
# SHARED_FEED_ALLOW_ORIGIN=*
# SHARED_FEED_FILE=server/shared-feed.json
